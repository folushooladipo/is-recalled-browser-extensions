{
  "name": "is-recalled-chrome-extension",
  "packageManager": "yarn@4.10.3",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "parcel watch manifest.json --host localhost --port 8000",
    "build": "rimraf dist/ && parcel build manifest.json"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "devDependencies": {
    "@parcel/config-webextension": "^2.16.1",
    "@parcel/optimizer-terser": "^2.16.1",
    "@parcel/transformer-typescript-tsc": "^2.16.1",
    "@types/chrome": "^0.0.242",
    "@types/progressbar.js": "^1.1.7",
    "buffer": "^5.5.0||^6.0.0",
    "parcel": "^2.9.3",
    "process": "^0.11.10",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3",
    "url": "^0.11.4"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@mlc-ai/web-llm": "^0.2.79",
    "progressbar.js": "^1.1.1",
    "sanitize-html": "^2.17.0"
  }
